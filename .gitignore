# Сборка Rust и Tauri
desktop/src-tauri/target/
desktop/src-tauri/gen/schemas/
desktop/Sol Flow.app/
desktop/*.zip

# DLL движка, которые CI кладёт рядом с конфигом перед упаковкой
desktop/src-tauri/*.dll

# Статические библиотеки sherpa-onnx: 150+ МБ на платформу, собираются
# отдельно (build-macos) и подкладываются в sherpa/lib перед сборкой.
desktop/src-tauri/sherpa/lib/
desktop/src-tauri/sherpa/win/

# Сборка Android
app-android/app/build/
app-android/app/.cxx/
app-android/build/
app-android/.gradle/
app-android/local.properties
*.apk
*.aab
*.so
*.a
*.jar

# Чужие исходники, которые лежат рядом рабочими копиями
upstream/
sherpa-onnx/
tcpp/

# Модели и тестовый звук — гигабайты, качаются каталогом
/models/
*.gguf
*.bin
*.wav
# Звук начала записи — часть кода, а не тестовые данные: на десктопе он
# вшивается в бинарь, на телефоне лежит ресурсом.
!desktop/src-tauri/sounds/*.wav
!app-android/app/src/main/res/raw/*.wav

# Система
.DS_Store
# Локальные настройки и скиллы Claude Code — инструмент, а не продукт
.claude/

# Стенд саммери: клон llama.cpp для прототипов, в сборку не входит
/llama.cpp/
/desktop/src-tauri/llama/
/app-android/app/src/main/jniLibs/

# Ключи Google OAuth: GitHub не пускает их в публичный репозиторий, CI берёт из секрета GOOGLE_OAUTH_JSON
google-oauth.json

# iPhone: проект генерируется XcodeGen-ом, движок собирается скриптом,
# модель для стенда подкладывается руками, команда подписи — личная
app-ios/*.xcodeproj/
app-ios/Local.xcconfig
app-ios/Engine/
app-ios/SolFlow/Models/
app-ios/DerivedData/
!app-ios/SolFlow/Resources/*.wav
app-ios/SolFlow.xcodeproj/

# Isolated local verification (no release artifacts)
.local-tools/
desktop/src-tauri/target-local-check/
/target-local-check/
