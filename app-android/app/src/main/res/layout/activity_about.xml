<?xml version="1.0" encoding="utf-8"?>
<!-- О проекте: кто, из чего собрано, где новая версия и как пожаловаться. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/canvas">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="-11dp"
            android:padding="11dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/Text.Eyebrow"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/about_title" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <TextView
                style="@style/Text.Display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/app_name" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/about_pitch" />

            <TextView
                style="@style/Text.Eyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/about_author_kicker" />

            <TextView
                style="@style/Text.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/about_author" />

            <TextView
                style="@style/Text.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="14sp"
                android:text="@string/about_author_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/linkSite"
                style="@style/Pill.Inset"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="16dp"
                android:text="@string/link_site" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/linkTelegram"
                style="@style/Pill.Inset"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:text="@string/link_telegram" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/linkYoutube"
                style="@style/Pill.Inset"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:text="@string/link_youtube" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/linkMail"
                style="@style/Pill.Inset"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:text="@string/link_mail" />

            <TextView
                style="@style/Text.Eyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/support_kicker" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/support_title" />

            <TextView
                style="@style/Text.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="14sp"
                android:text="@string/support_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/linkSupport"
                style="@style/Pill.Inset"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:text="@string/support_button" />

            <TextView
                style="@style/Text.Eyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/about_version_kicker" />

            <TextView
                android:id="@+id/version"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/updateStatus"
                style="@style/Text.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
                android:text="@string/update_hint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/checkUpdate"
                style="@style/Pill.Inset"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:text="@string/update_check" />

            <TextView
                style="@style/Text.Eyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/about_stack_kicker" />

            <TextView
                style="@style/Text.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="14sp"
                android:text="@string/about_stack" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/linkEngine"
                style="@style/Pill.Inset"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:text="@string/link_engine" />

            <TextView
                style="@style/Text.Eyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/about_bug_kicker" />

            <TextView
                style="@style/Text.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/report_title" />

            <TextView
                style="@style/Text.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="14sp"
                android:text="@string/report_hint" />

            <EditText
                android:id="@+id/bugText"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_inner"
                android:gravity="top"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="4"
                android:padding="14dp"
                android:textColorHint="@color/fog"
                android:hint="@string/report_placeholder"
                android:importantForAutofill="no" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bugSend"
                style="@style/Pill"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="@string/report_send" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bugCopy"
                style="@style/Pill.Inset"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:text="@string/report_copy" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/showIntro"
                style="@style/Pill.Inset"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="32dp"
                android:text="@string/intro_again" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
