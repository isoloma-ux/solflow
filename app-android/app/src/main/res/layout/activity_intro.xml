<?xml version="1.0" encoding="utf-8"?>
<!--
  Вводный экран при первом запуске: четыре шага о том, что приложение
  умеет. Показывается один раз, повторно — из «О проекте».
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/canvas">

    <TextView
        android:id="@+id/step"
        style="@style/Text.Eyebrow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_waveform" />

        <TextView
            android:id="@+id/title"
            style="@style/Text.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/text"
            style="@style/Text.BodyLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/fog" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/next"
        style="@style/Pill"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/intro_next" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/skip"
        style="@style/Pill.Inset"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="@string/intro_skip" />

</LinearLayout>
