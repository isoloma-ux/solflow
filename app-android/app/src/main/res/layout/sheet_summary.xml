<?xml version="1.0" encoding="utf-8"?>
<!--
  Саммери целиком — отдельным нижним листом во весь экран. В карточке
  встречи остаются первые строки: длинное саммери не должно отнимать место
  у расшифровки.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/canvas"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="16dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        android:id="@+id/summaryTitle"
        style="@style/Text.Heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/meeting_summary" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:scrollbars="vertical"
        android:fadeScrollbars="true">

        <TextView
            android:id="@+id/summaryText"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.3"
            android:textIsSelectable="true" />
    </androidx.core.widget.NestedScrollView>

    <TextView
        style="@style/Text.Muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="12sp"
        android:text="@string/summary_hint" />

    <!-- Тот же ряд, что и в листе расшифровки: скопировать, поделиться,
         экспорт — чтобы оба листа читались одинаково. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/summaryCopy"
            style="@style/Pill.Inset"
            app:icon="@drawable/ic_copy"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="16dp"
            app:iconTint="@color/ink"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="42dp"
            android:textSize="13sp"
            android:text="@string/copy" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/summaryShare"
            style="@style/Pill.Inset"
            app:icon="@drawable/ic_share"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="16dp"
            app:iconTint="@color/ink"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:textSize="13sp"
            android:text="@string/share_short" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/summaryExport"
            style="@style/Pill.Inset"
            app:icon="@drawable/ic_download"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="16dp"
            app:iconTint="@color/ink"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:textSize="13sp"
            android:text="@string/meeting_export" />
    </LinearLayout>
</LinearLayout>
