<?xml version="1.0" encoding="utf-8"?>
<!--
  Вкладка встреч живёт в двух состояниях: список с кнопками записи и импорта
  и раскрытая встреча с таймлайном. Это не отдельные экраны, а два слоя
  одного FrameLayout — так же, как сами вкладки в MainActivity.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/meetingsHome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/menuMeetings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="-13dp"
                android:padding="13dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/menu_open"
                android:src="@drawable/ic_menu" />
            <TextView
                style="@style/Text.Eyebrow"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/tab_meetings" />
        </LinearLayout>

        <TextView
            android:id="@+id/meetingStatus"
            style="@style/Text.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/meeting_idle" />

      <LinearLayout
        android:id="@+id/meetingTools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!--
          Кнопка записи — круглая, как у современных рекордеров: один жест,
          одно значение. Кольцо позади пульсирует, пока идет запись.
        -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <View
                android:id="@+id/recordPulse"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/bg_record_pulse" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/meetingRecord"
                style="@style/Pill"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:contentDescription="@string/meeting_record"
                app:cornerRadius="36dp"
                app:icon="@drawable/ic_mic"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="28dp"
                app:iconTint="@color/on_accent" />
        </FrameLayout>

        <!-- Табличные цифры: таймер не дрожит при смене разрядов. -->
        <TextView
            android:id="@+id/meetingTimer"
            style="@style/Text.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:visibility="gone" />

        <com.handy.voice.WaveView
            android:id="@+id/meetingWave"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:layout_marginStart="44dp"
            android:layout_marginEnd="44dp"
            android:visibility="gone" />

        <!-- Пауза и «глушить фон» живут только во время записи и занимают
             место кнопок импорта, которые в этот момент всё равно ни к чему. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/meetingPause"
            style="@style/Pill.Inset"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="44dp"
            android:layout_marginEnd="44dp"
            android:visibility="gone"
            android:text="@string/meeting_pause" />

        <LinearLayout
            android:id="@+id/meetingSuppressRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="44dp"
            android:layout_marginEnd="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                style="@style/Text.Body"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/meeting_suppress" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/meetingSuppressSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/meetingImport"
            style="@style/Pill.Inset"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="44dp"
            android:layout_marginEnd="44dp"
            android:text="@string/meeting_import" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/meetingLink"
            style="@style/Pill.Inset"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="44dp"
            android:layout_marginEnd="44dp"
            android:text="@string/meeting_link" />
      </LinearLayout>

        <!--
          Поиск и папка-фильтр над списком: пока встреч единицы, они не
          нужны, поэтому оба прячутся, если список пуст.
        -->
        <EditText
            android:id="@+id/meetingSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="10dp"
            android:hint="@string/meeting_search_hint"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/ink"
            android:textColorHint="@color/fog"
            android:textSize="16sp"
            android:fontFamily="@font/inter_regular"
            android:importantForAutofill="no" />

        <LinearLayout
            android:id="@+id/meetingFilters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/filterProject"
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/project_all" />

            <TextView
                android:id="@+id/searchSummary"
                style="@style/Text.Muted"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:gravity="end"
                android:textSize="13sp" />
        </LinearLayout>

        <!--
          Панель пакетных действий: появляется после долгого нажатия на
          карточке и на это время забирает место у кнопки записи.
        -->
        <LinearLayout
            android:id="@+id/selectionPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/selectionCount"
                style="@style/Text.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/selectionTranscribe"
                    style="@style/Pill.Inset"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="42dp"
                    android:minWidth="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:textSize="13sp"
                    android:text="@string/meeting_transcribe" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/selectionProject"
                    style="@style/Pill.Inset"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:minWidth="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:textSize="13sp"
                    android:text="@string/selection_project" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/selectionExport"
                    style="@style/Pill.Inset"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="42dp"
                    android:minWidth="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:textSize="13sp"
                    android:text="@string/selection_export" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/selectionDelete"
                    style="@style/Pill.Inset"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:minWidth="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:textSize="13sp"
                    android:text="@string/selection_delete" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/selectionCancel"
                style="@style/Pill.Inset"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textSize="13sp"
                android:text="@string/select_cancel" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/meetingsEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_waveform" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/meetings_empty" />

            <TextView
                style="@style/Text.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
                android:gravity="center"
                android:text="@string/meetings_empty_hint" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/meetingList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:layoutAnimation="@anim/layout_stagger"
            android:clipToPadding="false"
            android:scrollbars="none" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/meetingDetail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Шапка: назад слева, корзина справа — удаление не должно
             выделяться кнопкой, ему хватает тихой иконки. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/meetingBack"
                style="@style/Text.Muted"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:text="@string/meeting_back" />

            <ImageButton
                android:id="@+id/meetingDelete"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/meeting_delete_cd"
                android:src="@drawable/ic_trash" />
        </LinearLayout>

        <!-- Тап по названию — переименование. -->
        <TextView
            android:id="@+id/meetingTitle"
            style="@style/Text.Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/meetingMeta"
            style="@style/Text.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <!--
          Поиск по открытой расшифровке: подсвечивает слово во всех репликах
          и ведёт по ним. Без него найти нужное место в двухчасовой встрече
          можно было только пролистыванием.
        -->
        <LinearLayout
            android:id="@+id/meetingFindRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/meetingFind"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="10dp"
                android:hint="@string/meeting_find_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/ink"
                android:textColorHint="@color/fog"
                android:textSize="15sp"
                android:fontFamily="@font/inter_regular"
                android:importantForAutofill="no" />

            <TextView
                android:id="@+id/meetingFindCount"
                style="@style/Text.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/meetingFindNext"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="-13dp"
                android:padding="13dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/find_next"
                android:src="@drawable/ic_next"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/meetingState"
            style="@style/Text.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <!-- Полоса хода работы — процентов в подписи мало, как у загрузок. -->
        <ProgressBar
            android:id="@+id/meetingProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progressTint="@color/accent_solid"
            android:progressBackgroundTint="@color/hairline"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/meetingTranscribe"
            style="@style/Pill"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="44dp"
            android:layout_marginEnd="44dp"
            android:visibility="gone"
            android:text="@string/meeting_transcribe" />

        <!-- Отмена идущей работы: расшифровки, импорта или разделения. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/meetingCancelWork"
            style="@style/Pill.Inset"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="12dp"
            android:layout_marginStart="44dp"
            android:layout_marginEnd="44dp"
            android:visibility="gone"
            android:textColor="@color/danger"
            app:strokeColor="@color/danger"
            android:text="@string/download_cancel" />

        <!-- Карточка саммери над таймлайном: черновик от модели. -->
        <LinearLayout
            android:id="@+id/meetingSummaryBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card_inner"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                style="@style/Text.Eyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/meeting_summary" />

            <!-- Длинное саммери прокручивается внутри карточки: колонка
                 детали не скроллится, и без потолка высоты кнопки экспорта
                 уезжали за экран (проверено на телефоне). -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/meetingSummaryScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fadeScrollbars="true"
                android:scrollbars="vertical">

                <TextView
                    android:id="@+id/meetingSummaryText"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.25"
                    android:textIsSelectable="true" />
            </androidx.core.widget.NestedScrollView>

            <TextView
                style="@style/Text.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="12sp"
                android:text="@string/summary_hint" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/meetingTimeline"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:layoutAnimation="@anim/layout_stagger"
            android:clipToPadding="false"
            android:scrollbars="none" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/meetingDiarize"
            style="@style/Pill.Inset"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            android:text="@string/meeting_diarize" />

        <!-- Экспорт: четыре формата одним рядом, подпись объясняет куда. -->
        <LinearLayout
            android:id="@+id/meetingExportRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/exportTxt"
                style="@style/Pill.Inset"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textSize="13sp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="42dp"
                android:text="@string/export_txt" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/exportMd"
                style="@style/Pill.Inset"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textSize="13sp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:text="@string/export_md" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/exportPdf"
                style="@style/Pill.Inset"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textSize="13sp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:text="@string/export_pdf" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/exportDoc"
                style="@style/Pill.Inset"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textSize="13sp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:text="@string/export_doc" />
        </LinearLayout>

        <!-- Поделиться текстом: переслать или закинуть во внешнюю LLM. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/meetingShareText"
            style="@style/Pill.Inset"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:text="@string/meeting_share_text" />

        <!-- Исходный звук встречи — WAV в Загрузки: изнутри приложения
             его иначе не достать. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/meetingSaveAudio"
            style="@style/Pill.Inset"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:text="@string/meeting_save_audio" />

        <!-- Скопировать — главное действие готовой расшифровки, поэтому
             акцентная. Зелёная кнопка на экране одна. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/meetingCopy"
            style="@style/Pill"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            android:text="@string/copy" />
    </LinearLayout>

</FrameLayout>
