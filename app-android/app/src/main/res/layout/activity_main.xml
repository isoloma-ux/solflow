<?xml version="1.0" encoding="utf-8"?>
<!--
  Шторка — второй уровень навигации: проекты и разделы приложения. Разделы
  остались внизу вкладками: на телефоне это норма Material, а бургер вместо
  них прятал бы навигацию за лишний тап.
-->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <LinearLayout
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/canvas">

    <com.handy.voice.SwipePagesLayout
        android:id="@+id/pages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/pageDictation"
            layout="@layout/page_dictation" />

        <include
            android:id="@+id/pageMeetings"
            layout="@layout/page_meetings" />

        <include
            android:id="@+id/pageHistory"
            layout="@layout/page_history" />

        <include
            android:id="@+id/pageModels"
            layout="@layout/page_models" />
    </com.handy.voice.SwipePagesLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/hairline" />

    <!--
      Нижняя навигация: пункты меню с зелёным подчёркиванием активного, как в
      фильтрах каталога и в меню на сайте. Скруглённые кнопки-пилюли здесь
      выглядели бы аляповато — их место наверху, у действий.

      Каждый пункт лежит в своей растянутой ячейке, а сам текст — по центру и
      по ширине содержимого: тогда подчёркивание обнимает надпись, а не тянется
      на треть экрана.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="4dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/navDictation"
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:minHeight="44dp"
                android:gravity="center"
                android:maxLines="1"
                android:foreground="?attr/selectableItemBackground"
                android:text="@string/tab_dictation" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/navMeetings"
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:minHeight="44dp"
                android:gravity="center"
                android:maxLines="1"
                android:foreground="?attr/selectableItemBackground"
                android:text="@string/tab_meetings" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/navHistory"
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:minHeight="44dp"
                android:gravity="center"
                android:maxLines="1"
                android:foreground="?attr/selectableItemBackground"
                android:text="@string/tab_history" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/navModels"
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:minHeight="44dp"
                android:gravity="center"
                android:maxLines="1"
                android:foreground="?attr/selectableItemBackground"
                android:text="@string/tab_models" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>

    <LinearLayout
        android:id="@+id/drawerPanel"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@color/graphite"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            style="@style/Text.Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/app_name" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/drawerList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="24dp"
                android:orientation="vertical" />
        </ScrollView>

        <!-- Подвал меню, как в боковой панели на компьютере: активная модель
             и версия. Обе строки — кнопки: модель меняется на месте, версия
             проверяет обновление и предлагает поставить. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/hairline" />

        <TextView
            android:id="@+id/drawerModel"
            style="@style/Text.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="14dp"
            android:paddingBottom="6dp"
            android:textSize="14sp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/drawerVersion"
            style="@style/Text.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:paddingBottom="20dp"
            android:textSize="13sp"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
