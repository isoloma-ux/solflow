<?xml version="1.0" encoding="utf-8"?>
<!--
  Выбор числа говорящих — нижний лист вместо центрального диалога: варианты
  оказываются прямо под пальцем, а сам жест привычнее для современных
  приложений.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/canvas"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="16dp">

    <!-- Ручка листа. -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        android:id="@+id/sheetTitle"
        style="@style/Text.Heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/diarize_dialog_title" />

    <TextView
        android:id="@+id/sheetHint"
        style="@style/Text.Muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="14sp"
        android:visibility="gone"
        android:text="@string/diarize_download_hint" />

    <LinearLayout
        android:id="@+id/sheetOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical" />

</LinearLayout>
