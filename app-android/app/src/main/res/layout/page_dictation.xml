<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!--
          Шапка страницы: бургер открывает шторку с проектами, настройками
          и «О проекте». Разделы остались вкладками внизу — на телефоне это
          норма Material, а бургер вместо них прятал бы навигацию.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/menuDictation"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="-13dp"
                android:padding="13dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/menu_open"
                android:src="@drawable/ic_menu" />

            <TextView
                style="@style/Text.Eyebrow"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/eyebrow_dictation" />
        </LinearLayout>

        <!--
          Название модели — кнопка: тап открывает список скачанных, чтобы
          сменить модель, не уходя на вкладку каталога.
        -->
        <TextView
            android:id="@+id/modelName"
            style="@style/Text.Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginStart="-8dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/status"
            style="@style/Text.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/starting" />

        <!--
          Кнопка записи круглая, как на встречах: один язык записи во всем
          приложении. Кольцо позади пульсирует, пока идет диктовка.
        -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp">

            <View
                android:id="@+id/dictationPulse"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/bg_record_pulse" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/record"
                style="@style/Pill"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:contentDescription="@string/record"
                android:enabled="false"
                app:cornerRadius="36dp"
                app:icon="@drawable/ic_mic"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="28dp"
                app:iconTint="@color/on_accent" />
        </FrameLayout>

        <com.handy.voice.WaveView
            android:id="@+id/dictationWave"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="12dp"
            android:layout_marginStart="44dp"
            android:layout_marginEnd="44dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/result"
            style="@style/Text.BodyLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textIsSelectable="true" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/copy"
            style="@style/Pill.Inset"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            android:text="@string/copy" />

        <!--
          Подготовка вынесена на отдельную панель: раньше она шла сплошной
          лентой следом за диктовкой, и было непонятно, где кончается работа
          и начинаются настройки.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="44dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_panel"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <TextView
                style="@style/Text.Eyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/eyebrow_setup" />

            <TextView
                style="@style/Text.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/bubble_title" />

            <TextView
                style="@style/Text.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="14sp"
                android:text="@string/bubble_subtitle" />

            <!--
              Предупреждение о работе в урезанном режиме. Красного в палитре
              нет, поэтому выделяем не цветом, а контрастом: текст
              «чернилами», а не приглушённый, как в остальных подписях.
            -->
            <TextView
                android:id="@+id/degradedWarning"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card_inner"
                android:padding="16dp"
                android:textSize="14sp"
                android:visibility="gone"
                android:text="@string/degraded_warning" />

            <!--
              Когда всё выдано, карточки превращаются в одну строку: на рабочем
              экране им незачем занимать пол-экрана.
            -->
            <TextView
                android:id="@+id/permissionsSummary"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card_inner"
                android:padding="16dp"
                android:textSize="15sp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true" />

            <LinearLayout
                android:id="@+id/permissions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bubbleToggle"
                style="@style/Pill.Inset"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="18dp"
                android:text="@string/bubble_enable" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
