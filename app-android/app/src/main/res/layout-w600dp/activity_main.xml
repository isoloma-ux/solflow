<?xml version="1.0" encoding="utf-8"?>
<!--
  Широкий экран (планшет, альбом): разделы уезжают в рельс слева. Нижняя
  панель на такой ширине оставляла бы полэкрана пустым, а до неё пришлось бы
  тянуться через весь экран — Material для expanded-ширины прямо предписывает
  рельс или шторку.
-->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <LinearLayout
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/canvas">

    <LinearLayout
        android:layout_width="160dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingEnd="16dp">

            <TextView
                android:id="@+id/navDictation"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:foreground="?attr/selectableItemBackground"
                android:text="@string/tab_dictation" />

            <TextView
                android:id="@+id/navMeetings"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:foreground="?attr/selectableItemBackground"
                android:text="@string/tab_meetings" />

            <TextView
                android:id="@+id/navHistory"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:foreground="?attr/selectableItemBackground"
                android:text="@string/tab_history" />

            <TextView
                android:id="@+id/navModels"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:foreground="?attr/selectableItemBackground"
                android:text="@string/tab_models" />
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="24dp"
        android:background="@color/hairline" />

    <com.handy.voice.SwipePagesLayout
        android:id="@+id/pages"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <include
            android:id="@+id/pageDictation"
            layout="@layout/page_dictation" />

        <include
            android:id="@+id/pageMeetings"
            layout="@layout/page_meetings" />

        <include
            android:id="@+id/pageHistory"
            layout="@layout/page_history" />

        <include
            android:id="@+id/pageModels"
            layout="@layout/page_models" />
    </com.handy.voice.SwipePagesLayout>
  </LinearLayout>

    <LinearLayout
        android:id="@+id/drawerPanel"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@color/graphite"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            style="@style/Text.Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/app_name" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/drawerList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="24dp"
                android:orientation="vertical" />
        </ScrollView>

        <!-- Подвал меню: активная модель и версия. То же, что в узкой
             раскладке — иначе биндинг видит поля не везде. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/hairline" />

        <TextView
            android:id="@+id/drawerModel"
            style="@style/Text.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="14dp"
            android:paddingBottom="6dp"
            android:textSize="14sp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/drawerVersion"
            style="@style/Text.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:paddingBottom="20dp"
            android:textSize="13sp"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
