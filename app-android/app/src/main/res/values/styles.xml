<?xml version="1.0" encoding="utf-8"?>
<!--
  Шкала типографики и компоненты по дизайн-системе ivansolomin.ru.
  Правило весов: только 400 (inter_regular) и 500 (inter_medium).
  Трекинг падает с ростом кегля, sentence case везде кроме мелких kicker-плашек.
-->
<resources>

    <style name="Text" parent="">
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:letterSpacing">0.015</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
    </style>

    <style name="Text.Display">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">32sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="Text.Heading">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="Text.Body">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Text.BodyLarge">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Text.Muted">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/fog</item>
    </style>

    <!-- Единственное место, где разрешён капс. -->
    <style name="Text.Eyebrow">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/fog</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.07</item>
    </style>

    <!-- Кнопки-пилюли: скругление 100dp. Акцентная — одна на экран. -->
    <style name="Pill" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.015</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">100dp</item>
        <item name="elevation">0dp</item>
        <item name="backgroundTint">@color/accent_solid</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="rippleColor">@color/accent_deep</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
    </style>

    <!-- Контурная пилюля: вторичные действия, без заливки. -->
    <style name="Pill.Inset" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.015</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">100dp</item>
        <item name="strokeColor">@color/hairline</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
    </style>

</resources>
