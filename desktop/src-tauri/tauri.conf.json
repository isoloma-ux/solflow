{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sol Flow",
  "version": "0.1.0",
  "identifier": "ru.ivansolomin.solflow",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Sol Flow",
        "width": 920,
        "height": 720,
        "minWidth": 700,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}