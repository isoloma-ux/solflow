{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sol Flow",
  "version": "0.2.2",
  "identifier": "ru.ivansolomin.solflow",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Sol Flow",
        "width": 920,
        "height": 720,
        "minWidth": 700,
        "minHeight": 520,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "nsis"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "languages": [
          "Russian",
          "English"
        ],
        "installMode": "currentUser"
      }
    }
  }
}