{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sol Flow",
  "version": "0.3.0",
  "identifier": "ru.ivansolomin.solflow",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Sol Flow",
        "width": 920,
        "height": 720,
        "minWidth": 700,
        "minHeight": 520,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "nsis"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "nsis": {
        "languages": [
          "Russian",
          "English"
        ],
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/isoloma-ux/solflow/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENENjczMDJDODNBNTYxOUUKUldTZVlhV0RMREJuelh2Q2xWUVVqYmVCMGM4UlorL2tLaUUzejJJYVVHdVlzMkp4QjhDUGtEL2UK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
