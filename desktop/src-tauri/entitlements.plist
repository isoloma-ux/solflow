<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Подпись включает «усиленный режим», а в нём macOS не спрашивает
      разрешение, а молча отказывает — если право не заявлено здесь. Ровно
      это и случилось: запись шла, звук приходил пустой, приложение даже не
      появлялось в списке доступа к микрофону.
    -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Приглушение колонок на время записи идёт через osascript. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <!--
      libsolflow_llama (саммери) — своя библиотека в Frameworks. Самоподписной
      сертификат не даёт Team ID, и строгая проверка библиотек в усиленном
      режиме такую загрузку режет — приложение падало на старте (проверено
      крашем). Поэтому проверка выключается; библиотеки в бандле всё равно
      подписаны тем же сертификатом.
    -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
